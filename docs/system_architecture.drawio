        <!-- ===== Define / Legend ===== -->
        <mxCell id="legend" value="*Define — Topics &amp; Symbols&#10;P = /digital_twin/boxes  (estimated cup poses)      St = world state { /cups_on_table , /stack }&#10;/llm_input  (GSP→LLM)    /llm_output  (plan/decision)    /move_result  (coarse pick)    /action_result  (result→GSP)&#10;Jt = robot state (/joint_states,/tf)    Gt = current goal    U = user command&#10;Groups:  blue = T1 Perception   ·   purple = T3 LLM Agent   ·   red = Docker + Bringup (T2)   ·   green = Robot / World" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
